+        window.SetDpiOverride(dpi);
+        for (size_t i = 0; i < items.size(); ++i)
+        {
+            const RectF bounds = list.GetItemBounds(i);
+            const POINT point{static_cast<LONG>(DipsToPixels(bounds.x + bounds.width * 0.5f, dpi)),

--- /dev/null
+++ b/server/src/window/candidate_animation_scheduler.h
@@ -0,0 +1,192 @@
+#pragma once
+
+#include <windows.h>
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <mutex>
+
+// A single outstanding animation wake-up, with no drawing or input work on the
+// thread-pool thread. All public methods are called by the owning UI thread.
+class CandidateAnimationScheduler
+{
+  public:
+    using Clock = std::chrono::steady_clock;
+
+    CandidateAnimationScheduler() = default;
+    CandidateAnimationScheduler(const CandidateAnimationScheduler &) = delete;
+    CandidateAnimationScheduler &operator=(const CandidateAnimationScheduler &) = delete;
+
+    ~CandidateAnimationScheduler()
+    {
+        Cancel();
+    }
+
+    bool Bind(HWND window, UINT message)
+    {
+        Cancel();
+        std::lock_guard<std::mutex> lock(mutex_);
+        window_ = IsWindow(window) ? window : nullptr;
+        message_ = message;
+        return window_ && message_ != 0;
+    }
+
+    // Presentation policy: a missed decorative frame yields briefly instead
+    // of immediately redrawing under sustained load. Future deadlines stay exact.
+    // Schedule itself still accepts past deadlines for prompt notification.
+    static Clock::time_point YieldIfOverdue(Clock::time_point deadline, Clock::time_point now)
+    {
+        return deadline <= now ? now + std::chrono::milliseconds(2) : deadline;
+    }
+
+    bool Schedule(Clock::time_point deadline)
+    {
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            if (!window_ || !message_)
+                return false;
+            // Input/paint updates must not postpone a frame which is already
+            // due, or stack another message behind an unconsumed wake-up.
+            if (queued_ || (armed_ && deadline_ <= deadline))
+                return true;
+            InvalidateLocked();
+        }
+        if (!EnsureResources())
+            return false;
+        QuiesceWait();
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            deadline_ = deadline;
+            armed_ = true;
+        }
+
+        // A negative relative FILETIME avoids wall-clock changes. Round upward
+        // to 100 ns, rather than rounding a 60 Hz interval up to 17 ms.
+        using TimerTick = std::chrono::duration<long long, std::ratio<1, 10000000>>;
+        const auto remaining = deadline - Clock::now();
+        auto ticks = std::chrono::ceil<TimerTick>(remaining).count();
+        if (ticks < 1)
+            ticks = 1;
+        LARGE_INTEGER due{};
+        due.QuadPart = -ticks;
+        if (!SetWaitableTimer(timer_, &due, 0, nullptr, nullptr, FALSE))
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            InvalidateLocked();
+            return false;
+        }
+        SetThreadpoolWait(wait_, timer_, nullptr);
+        return true;
+    }
+
+    void Cancel()
+    {
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            InvalidateLocked();
+        }
+        // Never hold mutex_ while joining a callback: it takes the same lock.
+        QuiesceWait();
+        if (wait_)
+        {
+            CloseThreadpoolWait(wait_);
+            wait_ = nullptr;
+        }
+        if (timer_)
+        {
+            CloseHandle(timer_);
+            timer_ = nullptr;
+        }
+        highResolution_ = false;
+    }
+
+    bool ConsumeMessage(WPARAM generation, LPARAM instance)
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (static_cast<UINT_PTR>(instance) != instance_ || !queued_ || generation != generation_)
+            return false;
+        queued_ = false;
+        return true;
+    }
+
+    bool IsHighResolution() const
+    {
+        return highResolution_;
+    }
+
+  private:
+    static UINT_PTR NextInstance()
+    {
+        static std::atomic<UINT_PTR> next{1};
+        UINT_PTR value = next.fetch_add(1, std::memory_order_relaxed);
+        if (value == 0)
+            value = next.fetch_add(1, std::memory_order_relaxed);
+        return value;
+    }
+
+    void InvalidateLocked()
+    {
+        armed_ = false;
+        queued_ = false;
+        if (++generation_ == 0)
+            ++generation_;
+    }
+
+    bool EnsureResources()
+    {
+        if (timer_ && wait_)
+            return true;
+        // Older Windows releases reject the high-resolution flag; an ordinary
+        // waitable timer remains a supported, correct fallback.
+        constexpr DWORD kHighResolution = 0x00000002;
+        constexpr DWORD access = TIMER_MODIFY_STATE | SYNCHRONIZE;
+        timer_ = CreateWaitableTimerExW(nullptr, nullptr, kHighResolution, access);
+        highResolution_ = timer_ != nullptr;
+        if (!timer_)
+            timer_ = CreateWaitableTimerExW(nullptr, nullptr, 0, access);
+        if (!timer_)
+            return false;
+        wait_ = CreateThreadpoolWait(&TimerReady, this, nullptr);
+        if (wait_)
+            return true;
+        CloseHandle(timer_);
+        timer_ = nullptr;
+        highResolution_ = false;
+        return false;
+    }
+
+    void QuiesceWait()
+    {
+        if (wait_)
+            SetThreadpoolWait(wait_, nullptr, nullptr);
+        if (timer_)
+            CancelWaitableTimer(timer_);
+        if (wait_)
+            WaitForThreadpoolWaitCallbacks(wait_, TRUE);
+    }
+
+    static void CALLBACK TimerReady(PTP_CALLBACK_INSTANCE, void *context, PTP_WAIT, TP_WAIT_RESULT result)
+    {
+        auto &self = *static_cast<CandidateAnimationScheduler *>(context);
+        std::lock_guard<std::mutex> lock(self.mutex_);
+        if (result != WAIT_OBJECT_0 || !self.armed_ || self.queued_)
+            return;
+        self.armed_ = false;
+        self.queued_ = true;
+        if (!PostMessageW(self.window_, self.message_, self.generation_, static_cast<LPARAM>(self.instance_)))
+            self.queued_ = false;
+    }
+
+    std::mutex mutex_;
+    HWND window_ = nullptr;
+    UINT message_ = 0;
+    HANDLE timer_ = nullptr;
+    PTP_WAIT wait_ = nullptr;
+    Clock::time_point deadline_{};
+    const UINT_PTR instance_ = NextInstance();
+    UINT_PTR generation_ = 1;
+    bool armed_ = false;
+    bool queued_ = false;
+    bool highResolution_ = false;
+};
diff --git a/server/src/window/candidate_band_artwork_geometry.h b/server/src/window/candidate_band_artwork_geometry.h
new file mode 100644
index 0000000..c66040e
--- /dev/null
+++ b/server/src/window/candidate_band_artwork_geometry.h
@@ -0,0 +1,35 @@
+#pragma once
+
+#include "window/candidate_item_geometry.h"
+
+#include <algorithm>
+#include <cmath>
+#include <optional>
+
+struct CandidateBandArtworkGeometryDip
+{
+    CandidateItemRectDip backgroundDestination;
+    CandidateItemRectDip backgroundClip;
+    CandidateItemRectDip foregroundDestination;
+};
+
+// The full-size art never stretches with the card. Only the background clip
+// and the right-anchored foreground position depend on the current card width.
+inline std::optional<CandidateBandArtworkGeometryDip> CandidateBandArtworkGeometryFromBounds(
+    const CandidateItemRectDip &card, float widthDip, float heightDip, float offsetYDip, float foregroundRightClipDip)
+{
+    if (!std::isfinite(card.x) || !std::isfinite(card.y) || !std::isfinite(card.width) || !std::isfinite(card.height) ||
+        card.width <= 0.0f || card.height <= 0.0f || !std::isfinite(widthDip) || !std::isfinite(heightDip) ||
+        !std::isfinite(offsetYDip) || !std::isfinite(foregroundRightClipDip) || widthDip <= 0.0f ||
+        widthDip > 4096.0f || heightDip <= 0.0f || heightDip > 4096.0f || std::abs(offsetYDip) > 4096.0f ||
+        foregroundRightClipDip < 0.0f || foregroundRightClipDip > widthDip)
+        return std::nullopt;
+    const float y = card.y + offsetYDip;
+    const float right = card.x + card.width;
+    if (!std::isfinite(y) || !std::isfinite(right))
+        return std::nullopt;
+    return CandidateBandArtworkGeometryDip{
+        {card.x, y, widthDip, heightDip},
+        {card.x, y, (std::max)(card.width - foregroundRightClipDip, 0.0f), heightDip},
+        {right - widthDip, y, widthDip, heightDip}};
+}
diff --git a/server/src/window/candidate_item_separators.h b/server/src/window/candidate_item_separators.h
new file mode 100644
index 0000000..fc80717
--- /dev/null
+++ b/server/src/window/candidate_item_separators.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include "window/candidate_item_geometry.h"
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+struct CandidateItemSeparatorLineDip
+{
+    float x = 0.0f;
+    float top = 0.0f;
+    float bottom = 0.0f;
+    float width = 0.0f;
+};
+
+// Use the same arranged item rectangles as the text. Only internal boundaries
+// of the first horizontal row are decorated; nothing is inferred from a count.
+inline std::vector<CandidateItemSeparatorLineDip> CandidateItemSeparatorLinesFromBounds(
+    const CandidateItemRectDip &card, const std::vector<CandidateItemRectDip> &items, float topDip, float bottomDip,
+    float lineWidthDip, float lineGapDip)
+{
+    if (!std::isfinite(card.x) || !std::isfinite(card.y) || !std::isfinite(card.width) || !std::isfinite(card.height) ||
+        card.width <= 0.0f || card.height <= 0.0f || !std::isfinite(topDip) || !std::isfinite(bottomDip) ||
+        !std::isfinite(lineWidthDip) || !std::isfinite(lineGapDip) || topDip < 0.0f || bottomDip <= topDip ||
+        bottomDip > 4096.0f || lineWidthDip <= 0.0f || lineWidthDip > 4096.0f || lineGapDip < lineWidthDip ||
+        lineGapDip > 4096.0f)
+        return {};
+    const float top = (std::min)(topDip, card.height);
+    const float bottom = (std::min)(bottomDip, card.height);
+    if (bottom <= top)
+        return {};
+
+    const CandidateMainRowGeometry row = CandidateMainRowGeometryFromBounds(card, items);
+    std::vector<CandidateItemSeparatorLineDip> lines;
+    const float halfGap = lineGapDip * 0.5f;
+    const float outerHalfWidth = halfGap + lineWidthDip * 0.5f;
+    for (const float edge : row.edgesDip)
+    {
+        // Reject the whole pair at an edge rather than drawing a clipped half.
+        if (edge < outerHalfWidth || edge + outerHalfWidth > card.width)
+            continue;
+        lines.push_back({edge - halfGap, top, bottom, lineWidthDip});
+        lines.push_back({edge + halfGap, top, bottom, lineWidthDip});
+    }
+    return lines;
+}
diff --git a/server/src/window/candidate_typed_star_overlay.h b/server/src/window/candidate_typed_star_overlay.h
new file mode 100644
index 0000000..18a57aa
--- /dev/null
+++ b/server/src/window/candidate_typed_star_overlay.h
@@ -0,0 +1,226 @@
+#pragma once
+
+#include "skin/candidate_skin_catalog.h"
+#include "window/candidate_typed_stars.h"
+
+#include "msimeui/DeviceResources.h"
+#include "msimeui/Layout.h"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <optional>
+#include <random>
+#include <string>
+
+// Input events are consumed by the presenter. This visual only owns decorative state and draws it.
+class CandidateTypedStarOverlay : public msimeui::Visual
+{
+  public:
+    using Clock = msimeui::DeviceResources::AnimationClock;
+
+    CandidateTypedStarOverlay() : particles_(RuntimeSeed())
+    {
+    }
+
+    void Configure(const std::optional<CandidateSkinCatalog::TypedStars> &config, const std::wstring &root)
+    {
+        enabled_ = config.has_value();
+        Reset();
+        if (!enabled_)
+            return;
+        settings_ = {config->originXDip, config->originYDip, config->minXDip,
+                     config->maxXDip,    config->minYDip,    config->maxYDip};
+        settings_.widthMin = config->widthMinDip;
+        settings_.widthMax = config->widthMaxDip;
+        settings_.riseMin = config->riseMinDip;
+        settings_.riseMax = config->riseMaxDip;
+        settings_.endXMin = config->endXMinDip;
+        settings_.endXMax = config->endXMaxDip;
+        settings_.endYMin = config->endYMinDip;
+        settings_.endYMax = config->endYMaxDip;
+        settings_.durationMinMs = config->durationMinMs;
+        settings_.durationMaxMs = config->durationMaxMs;
+        settings_.fadeInMinMs = config->fadeInMinMs;
+        settings_.fadeInMaxMs = config->fadeInMaxMs;
+        settings_.fadeOutMinMs = config->fadeOutMinMs;
+        settings_.fadeOutMaxMs = config->fadeOutMaxMs;
+        settings_.rotationMinDeg = config->rotationMinDeg;
+        settings_.rotationMaxDeg = config->rotationMaxDeg;
+        settings_.spinMinDeg = config->spinMinDeg;
+        settings_.spinMaxDeg = config->spinMaxDeg;
+        settings_.pairSeparation = config->pairSeparationDip;
+        yellow_ = root + std::filesystem::u8path(config->yellowImage).wstring();
+        pink_ = root + std::filesystem::u8path(config->pinkImage).wstring();
+        const auto yellowAspect = PngAspectRatio(yellow_);
+        const auto pinkAspect = PngAspectRatio(pink_);
+        if (!yellowAspect || !pinkAspect)
+        {
+            enabled_ = false;
+            return;
+        }
+        settings_.yellowAspectRatio = *yellowAspect;
+        settings_.pinkAspectRatio = *pinkAspect;
+        settings_.blueEnabled = !config->blueImage.empty();
+        blue_.clear();
+        if (settings_.blueEnabled)
+        {
+            blue_ = root + std::filesystem::u8path(config->blueImage).wstring();
+            const auto blueAspect = PngAspectRatio(blue_);
+            if (!blueAspect)
+            {
+                enabled_ = false;
+                return;
+            }
+            settings_.blueAspectRatio = *blueAspect;
+        }
+        enabled_ = CandidateTypedStars::System::IsValidSettings(settings_);
+        if (enabled_)
+            particles_.Configure(settings_);
+    }
+
+    void SetTime(Clock::time_point time)
+    {
+        time_ = time;
+    }
+
+    const CandidateTypedStars::Settings &Parameters() const
+    {
+        return settings_;
+    }
+
+    void SpawnPairs(std::uint64_t count, Clock::time_point now)
+    {
+        if (!enabled_)
+            return;
+        time_ = now;
+        // Capacity is bounded in the model; stale batches cannot stall the UI thread.
+        count = (std::min)(count, static_cast<std::uint64_t>(CandidateTypedStars::System::kCapacity / 2));
+        for (std::uint64_t i = 0; i < count; ++i)
+            particles_.SpawnPair(Milliseconds(now));
+        if (count)
+            InvalidateVisual();
+    }
+
+    void Reset()
+    {
+        particles_.Reset();
+    }
+
+    std::optional<Clock::time_point> NextFrameDeadline() const
+    {
+        if (!enabled_)
+            return std::nullopt;
+        const auto next = particles_.NextFrameMs(Milliseconds(time_));
+        if (!next)
+            return std::nullopt;
+        return Clock::time_point(
+            std::chrono::duration_cast<Clock::duration>(std::chrono::duration<double, std::milli>(*next)));
+    }
+
+    msimeui::SizeF Measure(const msimeui::SizeF &) override
+    {
+        return {0.0f, 0.0f};
+    }
+
+    void Arrange(const msimeui::RectF &rect) override
+    {
+        bounds_ = rect;
+    }
+
+    bool HitTest(const msimeui::PointF &) const override
+    {
+        return false;
+    }
+
+    void Render(msimeui::DeviceResources &resources) override
+    {
+        if (!enabled_ || !resources.AreAnimationsEnabled())
+        {
+            Reset();
+            return;
+        }
+        auto *target = resources.GetRenderTarget();
+        if (!target || bounds_.width <= 0.0f || bounds_.height <= 0.0f)
+            return;
+        target->PushAxisAlignedClip(
+            D2D1::RectF(bounds_.x + static_cast<float>(settings_.minX), bounds_.y + static_cast<float>(settings_.minY),
+                        bounds_.x + static_cast<float>(settings_.maxX), bounds_.y + static_cast<float>(settings_.maxY)),
+            D2D1_ANTIALIAS_MODE_PER_PRIMITIVE);
+        D2D1_MATRIX_3X2_F transform;
+        target->GetTransform(&transform);
+        for (const auto &sample : particles_.Sample(Milliseconds(time_)))
+        {
+            if (sample.opacity <= 0.0)
+                continue;
+            D2D1_SIZE_F sourceSize{};
+            const auto &path = sample.color == CandidateTypedStars::Color::Blue   ? blue_
+                               : sample.color == CandidateTypedStars::Color::Pink ? pink_
+                                                                                  : yellow_;
+            auto *bitmap = resources.GetBitmapFromFile(path, &sourceSize);
+            if (!bitmap || sourceSize.width <= 0.0f || sourceSize.height <= 0.0f)
+                continue;
+            const float x = bounds_.x + static_cast<float>(sample.x);
+            const float y = bounds_.y + static_cast<float>(sample.y);
+            const float width = static_cast<float>(sample.width);
+            const float height = static_cast<float>(sample.height);
+            target->SetTransform(
+                D2D1::Matrix3x2F::Rotation(static_cast<float>(sample.rotationDeg), D2D1::Point2F(x, y)) * transform);
+            target->DrawBitmap(bitmap,
+                               D2D1::RectF(x - width / 2.0f, y - height / 2.0f, x + width / 2.0f, y + height / 2.0f),
+                               static_cast<float>(sample.opacity), D2D1_BITMAP_INTERPOLATION_MODE_LINEAR);
+        }
+        target->SetTransform(transform);
+        target->PopAxisAlignedClip();
+    }
+
+  private:
+    // Read only PNG metadata here; DeviceResources remains the sole bitmap decoder.
+    // All configured colors may use different image proportions without stretching or unsafe clipping.
+    static std::optional<double> PngAspectRatio(const std::wstring &path)
+    {
+        std::ifstream file(std::filesystem::path(path), std::ios::binary);
+        std::array<unsigned char, 24> bytes{};
+        if (!file.read(reinterpret_cast<char *>(bytes.data()), bytes.size()))
+            return std::nullopt;
+        constexpr std::array<unsigned char, 16> header{137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82};
+        if (!std::equal(header.begin(), header.end(), bytes.begin()))
+            return std::nullopt;
+        const auto integer = [&bytes](std::size_t at) {
+            return (static_cast<std::uint32_t>(bytes[at]) << 24) | (static_cast<std::uint32_t>(bytes[at + 1]) << 16) |
+                   (static_cast<std::uint32_t>(bytes[at + 2]) << 8) | bytes[at + 3];
+        };
+        const auto width = integer(16), height = integer(20);
+        if (!width || !height || width > 16384 || height > 16384)
+            return std::nullopt;
+        return static_cast<double>(width) / height;
+    }
+
+    static double Milliseconds(Clock::time_point time)
+    {
+        return std::chrono::duration<double, std::milli>(time.time_since_epoch()).count();
+    }
+
+    static std::uint32_t RuntimeSeed()
+    {
+        try
+        {
+            return std::random_device{}();
+        }
+        catch (...)
+        {
+            return static_cast<std::uint32_t>(Clock::now().time_since_epoch().count());
+        }
+    }
+
+    CandidateTypedStars::Settings settings_;
+    CandidateTypedStars::System particles_;
+    Clock::time_point time_{};
+    std::wstring yellow_;
+    std::wstring pink_;
+    std::wstring blue_;
+    bool enabled_ = false;
+};
diff --git a/server/src/window/candidate_typed_stars.h b/server/src/window/candidate_typed_stars.h
new file mode 100644
index 0000000..0c3b7b5
--- /dev/null
+++ b/server/src/window/candidate_typed_stars.h
@@ -0,0 +1,326 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <random>
+#include <vector>
+
+// Pure decorative state. Times are caller-supplied monotonic milliseconds;
+// coordinates are card-local DIPs, independent of layout, DPI and input state.
+namespace CandidateTypedStars
+{
+enum class Color
+{
+    Yellow,
+    Pink,
+    Blue
+};
+
+struct Settings
+{
+    double originX = 66.52;
+    double originY = 22.57;
+    double minX = 8.0;
+    double maxX = 107.0;
+    double minY = -100.0;
+    double maxY = 132.0;
+    double widthMin = 19.0;
+    double widthMax = 23.0;
+    double riseMin = 24.0;
+    double riseMax = 38.0;
+    double endXMin = 18.0;
+    double endXMax = 94.0;
+    double endYMin = 96.0;
+    double endYMax = 108.0;
+    double durationMinMs = 1200.0;
+    double durationMaxMs = 1450.0;
+    double fadeInMinMs = 90.0;
+    double fadeInMaxMs = 130.0;
+    double fadeOutMinMs = 260.0;
+    double fadeOutMaxMs = 360.0;
+    double rotationMinDeg = -24.0;
+    double rotationMaxDeg = 24.0;
+    double spinMinDeg = -70.0;
+    double spinMaxDeg = 70.0;
+    double pairSeparation = 22.0;
+    double yellowAspectRatio = 114.0 / 136.0;
+    double pinkAspectRatio = 114.0 / 136.0;
+    double blueAspectRatio = 114.0 / 136.0;
+    bool blueEnabled = false;
+};
+
+struct Sample
+{
+    // Bitmap center; rotation is about this point.
+    double x = 0.0;
+    double y = 0.0;
+    double width = 0.0;
+    double height = 0.0;
+    double rotationDeg = 0.0;
+    double opacity = 0.0;
+    Color color = Color::Yellow;
+};
+
+class System
+{
+  public:
+    static constexpr std::size_t kCapacity = 64;
+    static constexpr double kAspectRatio = 114.0 / 136.0;
+    static constexpr double kFrameMs = 1000.0 / 60.0;
+
+    explicit System(std::uint32_t seed) : random_(seed), paletteRandom_(seed ^ 0x9e3779b9U)
+    {
+        particles_.reserve(kCapacity);
+    }
+
+    // Validate the complete geometry before accepting an event. PNG aspect
+    // ratios come from the decoded images; they are never guessed or stretched.
+    static bool IsValidSettings(const Settings &settings)
+    {
+        const double values[] = {settings.originX,
+                                 settings.originY,
+                                 settings.minX,
+                                 settings.maxX,
+                                 settings.minY,
+                                 settings.maxY,
+                                 settings.widthMin,
+                                 settings.widthMax,
+                                 settings.riseMin,
+                                 settings.riseMax,
+                                 settings.endXMin,
+                                 settings.endXMax,
+                                 settings.endYMin,
+                                 settings.endYMax,
+                                 settings.durationMinMs,
+                                 settings.durationMaxMs,
+                                 settings.fadeInMinMs,
+                                 settings.fadeInMaxMs,
+                                 settings.fadeOutMinMs,
+                                 settings.fadeOutMaxMs,
+                                 settings.rotationMinDeg,
+                                 settings.rotationMaxDeg,
+                                 settings.spinMinDeg,
+                                 settings.spinMaxDeg,
+                                 settings.pairSeparation,
+                                 settings.yellowAspectRatio,
+                                 settings.pinkAspectRatio,
+                                 settings.blueAspectRatio};
+        for (double value : values)
+            if (!std::isfinite(value))
+                return false;
+        if (settings.minX >= settings.maxX || settings.minY >= settings.maxY ||
+            !std::isfinite(settings.maxX - settings.minX) || !std::isfinite(settings.maxY - settings.minY) ||
+            settings.widthMin <= 0.0 || settings.widthMin > settings.widthMax || settings.riseMin <= 0.0 ||
+            settings.riseMin > settings.riseMax || settings.endXMin > settings.endXMax ||
+            settings.endYMin > settings.endYMax || settings.endYMin < settings.originY ||
+            settings.durationMinMs <= 0.0 || settings.durationMinMs > settings.durationMaxMs ||
+            settings.fadeInMinMs <= 0.0 || settings.fadeInMinMs > settings.fadeInMaxMs ||
+            settings.fadeOutMinMs <= 0.0 || settings.fadeOutMinMs > settings.fadeOutMaxMs ||
+            settings.fadeInMaxMs + settings.fadeOutMaxMs > settings.durationMinMs ||
+            settings.rotationMinDeg > settings.rotationMaxDeg || settings.spinMinDeg > settings.spinMaxDeg ||
+            !std::isfinite(settings.rotationMaxDeg - settings.rotationMinDeg) ||
+            !std::isfinite(settings.spinMaxDeg - settings.spinMinDeg) ||
+            !std::isfinite(settings.rotationMinDeg + settings.spinMinDeg) ||
+            !std::isfinite(settings.rotationMaxDeg + settings.spinMaxDeg) || settings.pairSeparation <= 0.0 ||
+            settings.yellowAspectRatio <= 0.0 || settings.pinkAspectRatio <= 0.0 || settings.blueAspectRatio <= 0.0)
+            return false;
+        const double shortestFadeIn = settings.fadeInMinMs / settings.durationMaxMs;
+        const double shortestFadeOut = settings.fadeOutMinMs / settings.durationMaxMs;
+        if (shortestFadeIn <= 0.0 || shortestFadeIn >= 1.0 || shortestFadeOut <= 0.0 || shortestFadeOut >= 1.0 ||
+            1.0 - shortestFadeOut >= 1.0)
+            return false;
+        const double radius = SafetyRadius(settings);
+        if (!std::isfinite(radius) || settings.originX < settings.minX + radius ||
+            settings.originX > settings.maxX - radius || settings.originY < settings.minY + radius ||
+            settings.originY > settings.maxY - radius || settings.originY - settings.riseMax < settings.minY + radius ||
+            settings.endYMin < settings.minY + radius || settings.endYMax > settings.maxY - radius)
+            return false;
+        const double left = (std::max)(settings.endXMin, settings.minX + radius);
+        const double right = (std::min)(settings.endXMax, settings.maxX - radius);
+        if (right - left < settings.pairSeparation)
+            return false;
+        const double drop = settings.endYMax - settings.originY;
+        const double rootSum = std::sqrt(settings.riseMax) + std::sqrt(settings.riseMax + drop);
+        return std::isfinite(rootSum * rootSum);
+    }
+
+    void Configure(const Settings &settings)
+    {
+        settings_ = settings;
+        paletteCursor_ = palette_.size();
+        Reset();
+    }
+
+    void Reset()
+    {
+        particles_.clear();
+    }
+
+    void SpawnPair(double nowMs)
+    {
+        if (!std::isfinite(nowMs) || !IsValidSettings(settings_) || !std::isfinite(nowMs + settings_.durationMaxMs) ||
+            nowMs + settings_.durationMinMs <= nowMs)
+            return;
+        particles_.erase(std::remove_if(particles_.begin(), particles_.end(),
+                                        [nowMs](const Particle &particle) { return nowMs >= particle.endMs; }),
+                         particles_.end());
+
+        // Reserve the maximum rotated rectangle, including the original image
+        // aspect ratio, before choosing either endpoint. No per-frame clipping
+        // or adjustment can bend an otherwise ballistic flight.
+        const double radius = SafetyRadius(settings_);
+        const double left = (std::max)(settings_.endXMin, settings_.minX + radius);
+        const double right = (std::min)(settings_.endXMax, settings_.maxX - radius);
+
+        double endX1 = Uniform(left, right);
+        double endX2 = endX1;
+        for (int attempt = 0; attempt < 32 && std::abs(endX2 - endX1) < settings_.pairSeparation; ++attempt)
+            endX2 = Uniform(left, right);
+        if (std::abs(endX2 - endX1) < settings_.pairSeparation)
+        {
+            // A bounded fallback keeps every event a distinct two-star pair.
+            endX1 = Uniform(left, right - settings_.pairSeparation);
+            endX2 = Uniform(endX1 + settings_.pairSeparation, right);
+            if (Uniform(0.0, 1.0) < 0.5)
+                std::swap(endX1, endX2);
+        }
+        const bool firstPink = Uniform(0.0, 1.0) < 0.5;
+        // Keep the legacy motion RNG sequence unchanged when enabling the new palette.
+        const Color firstColor = settings_.blueEnabled ? NextColor() : firstPink ? Color::Pink : Color::Yellow;
+        const Color secondColor = settings_.blueEnabled ? NextColor() : firstPink ? Color::Yellow : Color::Pink;
+        Particle first = MakeParticle(nowMs, endX1, firstColor);
+        Particle second = MakeParticle(nowMs, endX2, secondColor);
+        while (particles_.size() + 2 > kCapacity)
+            particles_.erase(particles_.begin(), particles_.begin() + 2);
+        particles_.push_back(first);
+        particles_.push_back(second);
+    }
+
+    std::vector<Sample> Sample(double nowMs) const
+    {
+        std::vector<CandidateTypedStars::Sample> samples;
+        if (!std::isfinite(nowMs))
+            return samples;
+        samples.reserve(particles_.size());
+        for (const Particle &particle : particles_)
+        {
+            if (nowMs < particle.startMs || nowMs >= particle.endMs)
+                continue;
+            const double u = (nowMs - particle.startMs) / (particle.endMs - particle.startMs);
+            const double x = settings_.originX + (particle.endX - settings_.originX) * u;
+            const double y = settings_.originY + u * (particle.verticalLinear + particle.verticalQuadratic * u);
+            const double alphaIn = SmoothStep(u / particle.fadeInU);
+            const double alphaOut = 1.0 - SmoothStep((u - particle.fadeOutU) / (1.0 - particle.fadeOutU));
+            samples.push_back({x, y, particle.width, particle.height, particle.rotation + particle.spin * u,
+                               alphaIn * alphaOut, particle.color});
+        }
+        return samples;
+    }
+
+    bool HasLive(double nowMs) const
+    {
+        if (!std::isfinite(nowMs))
+            return false;
+        return std::any_of(particles_.begin(), particles_.end(), [nowMs](const Particle &particle) {
+            return nowMs >= particle.startMs && nowMs < particle.endMs;
+        });
+    }
+
+    std::optional<double> NextFrameMs(double nowMs) const
+    {
+        if (!HasLive(nowMs))
+            return std::nullopt;
+        double nextMs = nowMs + kFrameMs;
+        for (const Particle &particle : particles_)
+            if (nowMs >= particle.startMs && nowMs < particle.endMs)
+                nextMs = (std::min)(nextMs, particle.endMs);
+        return nextMs;
+    }
+
+  private:
+    struct Particle
+    {
+        double startMs;
+        double endMs;
+        double endX;
+        double width;
+        double height;
+        double verticalLinear;
+        double verticalQuadratic;
+        double fadeInU;
+        double fadeOutU;
+        double rotation;
+        double spin;
+        Color color;
+    };
+
+    static double SmoothStep(double value)
+    {
+        const double t = (std::clamp)(value, 0.0, 1.0);
+        return t * t * (3.0 - 2.0 * t);
+    }
+
+    double Uniform(double low, double high)
+    {
+        return std::uniform_real_distribution<double>(low, high)(random_);
+    }
+
+    static double SafetyRadius(const Settings &settings)
+    {
+        double aspect = (std::min)(settings.yellowAspectRatio, settings.pinkAspectRatio);
+        if (settings.blueEnabled)
+            aspect = (std::min)(aspect, settings.blueAspectRatio);
+        return 0.5 * std::hypot(settings.widthMax, settings.widthMax / aspect);
+    }
+
+    Color NextColor()
+    {
+        if (paletteCursor_ == palette_.size())
+        {
+            // Every completed bag emits exactly two blue, one pink and one yellow.
+            palette_ = {Color::Blue, Color::Blue, Color::Pink, Color::Yellow};
+            std::shuffle(palette_.begin(), palette_.end(), paletteRandom_);
+            paletteCursor_ = 0;
+        }
+        return palette_[paletteCursor_++];
+    }
+
+    Particle MakeParticle(double nowMs, double endX, Color color)
+    {
+        const double duration = Uniform(settings_.durationMinMs, settings_.durationMaxMs);
+        const double rise = Uniform(settings_.riseMin, settings_.riseMax);
+        const double drop = Uniform(settings_.endYMin, settings_.endYMax) - settings_.originY;
+        // Given rise r and final drop d, solve the upward initial velocity and
+        // downward acceleration. Both are constant for the whole lifetime.
+        const double rootRise = std::sqrt(rise);
+        const double rootSum = rootRise + std::sqrt(rise + drop);
+        const double width = Uniform(settings_.widthMin, settings_.widthMax);
+        const double aspect = color == Color::Blue   ? settings_.blueAspectRatio
+                              : color == Color::Pink ? settings_.pinkAspectRatio
+                                                     : settings_.yellowAspectRatio;
+        return {nowMs,
+                nowMs + duration,
+                endX,
+                width,
+                width / aspect,
+                -2.0 * rootRise * rootSum,
+                rootSum * rootSum,
+                Uniform(settings_.fadeInMinMs, settings_.fadeInMaxMs) / duration,
+                1.0 - Uniform(settings_.fadeOutMinMs, settings_.fadeOutMaxMs) / duration,
+                Uniform(settings_.rotationMinDeg, settings_.rotationMaxDeg),
+                Uniform(settings_.spinMinDeg, settings_.spinMaxDeg),
+                color};
+    }
+
+    Settings settings_;
+    std::mt19937 random_;
+    std::mt19937 paletteRandom_;
+    std::array<Color, 4> palette_{};
+    std::size_t paletteCursor_ = palette_.size();
+    std::vector<Particle> particles_;
+};
+} // namespace CandidateTypedStars

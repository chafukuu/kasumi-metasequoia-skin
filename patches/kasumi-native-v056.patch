+        {"fade_out_min_ms", &TypedStars::fadeOutMinMs},
+        {"fade_out_max_ms", &TypedStars::fadeOutMaxMs},
+        {"rotation_min_deg", &TypedStars::rotationMinDeg},
+        {"rotation_max_deg", &TypedStars::rotationMaxDeg},

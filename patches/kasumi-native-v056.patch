+    WriteBandArtworkFixtures(skinsRoot);
+    const char *fields = R"([candidate_window.band_artwork]
+background = "assets/background.png"
+foreground = "assets/foreground.PNG"
+width_dip = 1032
+height_dip = 344
+offset_y_dip = -219.75

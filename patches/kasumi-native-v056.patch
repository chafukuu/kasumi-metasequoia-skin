+        REQUIRE(!CandidateBandArtworkGeometryFromBounds(card, 1032.0f, invalid, -219.75f, 137.695027624309f));
+        REQUIRE(!CandidateBandArtworkGeometryFromBounds(card, 1032.0f, 344.0f, invalid, 137.695027624309f));

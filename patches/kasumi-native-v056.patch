+std::optional<CandidateSkinScene::EffectClock::time_point> CandidateSkinScene::NextTypedStarFrameDeadline() const
+{
+    return typedStarOverlay_ ? typedStarOverlay_->NextFrameDeadline() : std::nullopt;
+}
